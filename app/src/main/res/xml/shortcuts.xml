<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="refresh_weather"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_refresh_short"
        android:shortcutLongLabel="@string/shortcut_refresh_long">
        <intent
            android:action="com.zhisheng.weather.action.REFRESH"
            android:targetPackage="com.zhisheng.weather"
            android:targetClass="com.zhisheng.weather.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="search_city"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent
            android:action="com.zhisheng.weather.action.SEARCH"
            android:targetPackage="com.zhisheng.weather"
            android:targetClass="com.zhisheng.weather.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_settings"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_settings_short"
        android:shortcutLongLabel="@string/shortcut_settings_long">
        <intent
            android:action="com.zhisheng.weather.action.SETTINGS"
            android:targetPackage="com.zhisheng.weather"
            android:targetClass="com.zhisheng.weather.MainActivity" />
    </shortcut>
</shortcuts>
