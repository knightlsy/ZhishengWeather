<?xml version="1.0" encoding="utf-8"?>
<!-- 0.1.3Preview：分层半透明气象玻璃。保留终端边框，让桌面壁纸自然透入。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#B82D3540" android:centerColor="#A112171E" android:endColor="#C2070A0F" />
            <stroke android:width="1dp" android:color="#8AA4B1BE" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="3dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#921D2A35" android:centerColor="#78080E14" android:endColor="#8A101A22" />
            <stroke android:width="1dp" android:color="#5C36CFE1" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="12dp" android:top="5dp" android:right="12dp" android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <gradient android:angle="0" android:startColor="#00FFFFFF" android:centerColor="#72FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="1dp" />
        </shape>
    </item>
    <item android:left="14dp" android:right="14dp" android:bottom="5dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <gradient android:angle="0" android:startColor="#6620F0FF" android:centerColor="#284A5A66" android:endColor="#66FF9830" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
