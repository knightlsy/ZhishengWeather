<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · liquid terminal glass · translucent graphite, low-contrast cyan-grey edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C41A2229" />
            <stroke android:width="1dp" android:color="#565F7B82" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#1FFFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00152026" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
