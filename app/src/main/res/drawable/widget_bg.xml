<?xml version="1.0" encoding="utf-8"?>
<!-- 0.1.0：外壳高光、下沉内屏与青色电路边形成腕表式 3D 深度。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF424A55" android:centerColor="#FF171C23" android:endColor="#FF07090D" />
            <stroke android:width="1dp" android:color="#FF626E7A" />
            <corners android:radius="27dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="5dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FC151C24" android:centerColor="#FC080C12" android:endColor="#FC10171D" />
            <stroke android:width="1dp" android:color="#8036CFE1" />
            <corners android:radius="23dp" />
        </shape>
    </item>
    <item android:left="10dp" android:top="7dp" android:right="10dp" android:bottom="7dp" android:gravity="top">
        <shape android:shape="rectangle">
            <size android:height="1dp" />
            <solid android:color="#526A7886" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
