<?xml version="1.0" encoding="utf-8"?>
<!-- Hallmark · liquid terminal glass · translucent pearl, readable over bright wallpaper. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B8E8EEF1" />
            <stroke android:width="1dp" android:color="#B8FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#78FFFFFF"
                android:centerColor="#24FFFFFF"
                android:endColor="#0A8CB8C4" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
