<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 仅「设置 → 检查更新」下载公共包后调用系统安装器；不会静默安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      位置权限：应用启动时自动申请，用于获取当前位置以显示实时天气。
      使用粗略位置（ACCESS_COARSE_LOCATION）即可满足城市定位需求；
      仅在用户主动开启「精确位置」时才申请 ACCESS_FINE_LOCATION。
      始终不申请后台位置。
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <application
        android:name=".TianQiApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher_character"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_character_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TianQiWeather">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
        </activity>

        <!--
          桌面图标通过互斥 activity-alias 切换。先启用目标别名、再禁用旧别名，
          可在不重装 App 的前提下刷新桌面入口；默认使用角色图标。
        -->
        <activity-alias
            android:name=".IconCharacter"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_character"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_character_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <activity-alias
            android:name=".IconClassic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!--
          自定义图标：用户从相册上传本地图片后启用。上传的图片保存在应用私有目录
          （AppIconCustom.customIconFile），不落外部存储；别名在安装时即预声明，
          启用后桌面图标即切换到自定义入口。
        -->
        <activity-alias
            android:name=".IconCustom"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_custom"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_custom_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- 桌面小组件：五档硬件终端规格，共用同一套快照与配色逻辑。 -->
        <receiver
            android:name=".widget.TianQiWidgetNano"
            android:exported="false"
            android:label="@string/widget_label_nano">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_nano" />
        </receiver>

        <receiver
            android:name=".widget.TianQiWidgetSmall"
            android:exported="false"
            android:label="@string/widget_label_small">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_small" />
        </receiver>

        <receiver
            android:name=".widget.TianQiWidgetMedium"
            android:exported="false"
            android:label="@string/widget_label_medium">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_medium" />
        </receiver>

        <receiver
            android:name=".widget.TianQiWidgetLarge"
            android:exported="false"
            android:label="@string/widget_label_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_large" />
        </receiver>

        <receiver
            android:name=".widget.TianQiWidgetTower"
            android:exported="false"
            android:label="@string/widget_label_tower">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_tower" />
        </receiver>
    </application>

</manifest>
